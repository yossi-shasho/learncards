---
layout: base.njk
---
<h1>{{ heading }}</h1>
{%- set intro = intros[listSlug].intro if (listField == "categories" and intros and intros[listSlug]) else "" %}
{%- if intro %}
<div class="intro-text">
{{ intro | markdown | safe }}
</div>
{%- elif listDescription %}
<p class="intro">{{ listDescription }}</p>
{%- endif %}
{%- set items = collections.tricks | withTerm(listField, listSlug) %}
{%- if items.length %}
<ul class="listing">
{%- for t in items %}
  <li><a href="{{ t.url }}">{{ t.data.title }}</a>
    {%- if t.data.difficulty %} <span class="badge badge-{{ t.data.difficulty }}">{{ t.data.difficulty | capitalize }}</span>{% endif %} <small>&mdash; {{ t.date | longDate }}</small>
    {%- if t.data.excerpt %}<br><span class="excerpt">{{ t.data.excerpt }}</span>{% endif %}</li>
{%- endfor %}
</ul>
{%- else %}
<p>No tricks here yet.</p>
{%- endif %}
