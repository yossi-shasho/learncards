---
layout: base.njk
ogType: article
---
{%- set au = taxonomy.authors | bySlug(author) -%}
{%- set cats = categories | strs -%}
{%- set tagSlugs = tags | strs -%}
<article class="trick">
  <h1>{{ title }}</h1>
  <p class="byline">By {% if au %}<a href="/author/{{ au.slug }}/">{{ au.name }}</a>{% else %}{{ author }}{% endif %}
    on <time datetime="{{ date | isoDate }}">{{ date | longDate }}</time>
    {%- if cats.length %} &middot; Filed under
    {% for c in cats %}{% set rec = taxonomy.categories | bySlug(c) %}<a href="/category/{{ c }}/">{{ rec.name if rec else c }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}
  </p>
  {%- if video %}
  <div class="video"><iframe src="https://www.youtube.com/embed/{{ video | youtubeId }}" title="{{ title }}" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
  {%- endif %}
  <div class="body">
{{ content | safe }}
  </div>
  {%- if tagSlugs.length %}
  <p class="tags">Tags: {% for t in tagSlugs %}{% set rec = taxonomy.tags | bySlug(t) %}<a href="/tag/{{ t }}/">{{ rec.name if rec else t }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
  {%- endif %}
</article>
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "datePublished": date | isoDate,
  "dateModified": (modified or date) | isoDate,
  "author": { "@type": "Person", "name": (au.name if au else author), "url": site.url + "/author/" + author + "/" },
  "description": (seoDescription or excerpt or "") | striptags | trim,
  "mainEntityOfPage": site.url + page.url,
  "image": site.ogImage,
  "publisher": { "@type": "Organization", "name": site.name, "logo": { "@type": "ImageObject", "url": site.ogImage } }
} | dump | replace("<", "\\u003c") | safe }}
</script>
